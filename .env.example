# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/followup
DATABASE_USERNAME=followup
DATABASE_PASSWORD=changeme

# Used by docker-compose to provision the Postgres container itself
POSTGRES_DB=followup
POSTGRES_USER=followup
POSTGRES_PASSWORD=changeme

# --- Auth ---
JWT_SECRET=changeme
JWT_EXPIRATION_MINUTES=60

# --- Mail (Phase 2) ---
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Google Calendar (Phase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outlook Calendar (Phase 2) ---
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
