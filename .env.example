# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Default host port is 5544, not 5432, to avoid clashing with any other
# local/dev Postgres already bound to 5432 (or 5433/5434, both also
# commonly taken). Change DB_HOST_PORT (and this URL's port) if 5544 is
# also in use on your machine.
DATABASE_URL=jdbc:postgresql://localhost:5544/followup
DATABASE_USERNAME=followup
DATABASE_PASSWORD=changeme

# Used by docker-compose to provision the Postgres container itself
POSTGRES_DB=followup
POSTGRES_USER=followup
POSTGRES_PASSWORD=changeme
DB_HOST_PORT=5544

# --- Auth ---
JWT_SECRET=changeme
JWT_EXPIRATION_MINUTES=60
# Use a long random value (32+ chars) outside local dev, e.g. `openssl rand -base64 48`.

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Bootstrap ADMIN and STAFF accounts, created automatically on first
# startup if the users table is empty — see docs/TEST_ACCOUNTS.md. Change
# their passwords before any non-local deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=changeme

# --- Mail (parent emails: Meet invites) ---
# Dev default = the Mailpit container (docker compose): localhost:1025,
# inbox at http://localhost:8025. For Google Workspace in production use
# smtp-relay.gmail.com:587 (or smtp.gmail.com:587 with an app password),
# MAIL_SMTP_AUTH=true and MAIL_STARTTLS=true.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@example.com
CENTER_NAME=Kumon Center

# --- Online check-ins (Google Meet) — see docs/features/google-meet.md ---
# Background job that creates Meet links (48h before) and emails parents (24h before).
MEETINGS_AUTOMATION_ENABLED=true
MEETINGS_CREATE_LEAD=PT48H
MEETINGS_INVITE_LEAD=PT24H
# The center's IANA time zone — the whole backend runs on it ("today", overdue,
# Meet links, email times). Montréal = America/Toronto. Blank = server zone.
APP_TIMEZONE=America/Toronto
# Google OAuth client ("Web application" type) from Google Cloud Console —
# free, works with ordinary Gmail. Accounts are then connected in the app
# under Settings (a shared center account and/or each staff member's own).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed exactly in the OAuth client's "Authorized redirect URIs".
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google/oauth/callback
# Where the browser returns after connecting Google.
FRONTEND_URL=http://localhost:4200
# Encrypts the stored Google refresh tokens. Long random value outside local dev.
TOKEN_ENCRYPTION_KEY=

# --- Outlook Calendar (Phase 2) ---
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
